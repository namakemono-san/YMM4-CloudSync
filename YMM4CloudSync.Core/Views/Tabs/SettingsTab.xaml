<UserControl x:Class="YMM4CloudSync.Core.Views.Tabs.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:YMM4CloudSync.Core.ViewModels"
             xmlns:g="clr-namespace:YukkuriMovieMaker.Resources.Localization;assembly=YukkuriMovieMaker.Plugin"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Commons;assembly=YukkuriMovieMaker.Plugin"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance vm:ToolViewModel}">

    <UserControl.Resources>
        <Style TargetType="{x:Type Expander}">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="Button" x:Key="IconButtonStyle">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style TargetType="Button" x:Key="TextButtonStyle">
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="5" Grid.IsSharedSizeScope="True">

            <Expander Header="クラウド同期設定">
                <StackPanel Margin="10,5,5,10">
                    
                    <Grid Margin="0,0,0,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Label Grid.Row="0" Grid.Column="0" Content="プロジェクト保存先" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        
                        <TextBox Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center" 
                                 Text="{Binding ProjectDirectory.Value, UpdateSourceTrigger=PropertyChanged, Delay=1}"/>
                        
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="..." Command="{Binding BrowseProjectDirCommand}" 
                                    Style="{StaticResource IconButtonStyle}" ToolTip="フォルダを参照"/>
                            <Button Content="初期値" Command="{Binding ResetProjectDirCommand}" 
                                    Style="{StaticResource TextButtonStyle}" ToolTip="デフォルトに戻す"/>
                        </StackPanel>

                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,0"
                                 VerticalContentAlignment="Center" MinHeight="22" FontSize="11"
                                 Background="Transparent" BorderBrush="Transparent" IsReadOnly="True"
                                 Text="{Binding ProjectDirectoryPreview.Value, Mode=OneWay}"
                                 Opacity="0.6" TextWrapping="NoWrap"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/> <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="キャッシュ保存先" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <TextBox Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center"
                                 Text="{Binding CacheDirectory.Value, UpdateSourceTrigger=PropertyChanged, Delay=1}"/>

                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="..." Command="{Binding BrowseCacheDirCommand}" 
                                    Style="{StaticResource IconButtonStyle}" ToolTip="フォルダを参照"/>
                            <Button Content="初期値" Command="{Binding ResetCacheDirCommand}" 
                                    Style="{StaticResource TextButtonStyle}" ToolTip="デフォルトに戻す"/>
                        </StackPanel>

                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,0"
                                 VerticalContentAlignment="Center" MinHeight="22" FontSize="11"
                                 Background="Transparent" BorderBrush="Transparent" IsReadOnly="True"
                                 Text="{Binding CacheDirectoryPreview.Value, Mode=OneWay}"
                                 Opacity="0.6" TextWrapping="NoWrap"/>
                    </Grid>

                    <Grid>
                        <Label Content="起動時にアップデートを確認する"/>
                        <controls:ToggleSlider HorizontalAlignment="Right"
                                               Value="{Binding Settings.EnableUpdateCheck}" />
                    </Grid>

                    <TextBlock Text="※設定は自動的に保存されます。" Foreground="Gray" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
            </Expander>

            <Expander Header="{x:Static g:Texts.SpecialTags}" IsExpanded="False">
                <Grid Margin="10,5,5,10">
                    <Grid.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Grid.Column" Value="1"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0,5,0"/>
                        </Style>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="IsReadOnly" Value="True"/>
                            <Setter Property="Margin" Value="5,0,10,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"/>
                        </Style>
                        <Style TargetType="{x:Type Separator}">
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                            <Setter Property="Margin" Value="0,4,0,4"/>
                        </Style>
                    </Grid.Resources>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="&lt;YMMUserDir&gt;"/>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="{x:Static g:Texts.YMM4UserDirectory}" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Static c:AppDirectories.UserDirectory}" FontSize="10" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Separator Grid.Row="1"/>

                    <TextBox Grid.Row="2" Text="&lt;Desktop&gt;"/>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="{x:Static g:Texts.Desktop}" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Static c:AppDirectories.Desktop}" FontSize="10" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Separator Grid.Row="3"/>

                    <TextBox Grid.Row="4" Text="&lt;Documents&gt;"/>
                    <StackPanel Grid.Row="4" Grid.Column="1">
                        <TextBlock Text="{x:Static g:Texts.Documents}" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Static c:AppDirectories.Documents}" FontSize="10" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Separator Grid.Row="5"/>

                    <TextBox Grid.Row="6" Text="&lt;ProjectDir&gt;"/>
                    <StackPanel Grid.Row="6" Grid.Column="1">
                        <TextBlock Text="{x:Static g:Texts.ProjectDirectory}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>