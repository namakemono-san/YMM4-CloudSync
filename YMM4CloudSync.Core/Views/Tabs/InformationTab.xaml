<UserControl x:Class="YMM4CloudSync.Core.Views.Tabs.InformationTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:YMM4CloudSync.Core.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance vm:ToolViewModel}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="YMM4 Cloud Sync" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding VersionText}" Foreground="Gray" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="1">
                <TabItem Header="更新履歴">
                    <TextBox IsReadOnly="True" 
                             VerticalScrollBarVisibility="Auto" 
                             TextWrapping="Wrap"
                             Text="{Binding ChangelogText, Mode=OneWay}"/>
                </TabItem>
                
                <TabItem Header="ライセンス">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding Licenses}"
                                 DisplayMemberPath="Name"
                                 SelectedItem="{Binding CurrentLicense.Value, Mode=TwoWay, TargetNullValue=''}" />
                        
                        <TextBox Grid.Column="1"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 Text="{Binding CurrentLicense.Value.Text, Mode=OneWay, TargetNullValue=''}" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>