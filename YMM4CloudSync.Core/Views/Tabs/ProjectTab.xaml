<UserControl x:Class="YMM4CloudSync.Core.Views.Tabs.ProjectTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:YMM4CloudSync.Core.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance vm:ToolViewModel}">

    <UserControl.Resources>
        <ContextMenu x:Key="ProjectContextMenu">
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="プロジェクト一覧"
                       VerticalAlignment="Center"
                       FontWeight="Bold"/>

            <ComboBox Grid.Column="2"
                      Width="160"
                      Margin="0,0,8,0"
                      ItemsSource="{Binding CloudServices}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedCloudService.Value, Mode=TwoWay}"/>

            <Button Grid.Column="3"
                    x:Name="RefreshButton"
                    Padding="5,2"
                    Click="OnRefreshClick"
                    ToolTip="更新"
                    IsEnabled="False">
                <iconPacks:PackIconMaterial Kind="Refresh" Width="12" Height="12"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListBox x:Name="CloudFilesList"
                     Margin="0,0,0,10"
                     MinHeight="100"
                     HorizontalContentAlignment="Stretch"
                     ContextMenu="{StaticResource ProjectContextMenu}"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCloudService.Value.IsConnected}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Padding="4" Margin="2,0" ToolTip="開く" 
                                        Click="OnOpenClick" Tag="{Binding}">
                                    <iconPacks:PackIconMaterial Kind="FolderOpen" Width="14" Height="14"/>
                                </Button>
                                <Button Padding="4" Margin="2,0" ToolTip="ダウンロード"
                                        Click="OnDownloadClick" Tag="{Binding}">
                                    <iconPacks:PackIconMaterial Kind="Download" Width="14" Height="14"/>
                                </Button>
                                <Button Padding="4" Margin="2,0" ToolTip="削除"
                                        Click="OnDeleteClick" Tag="{Binding}">
                                    <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14" Foreground="Red"/>
                                </Button>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding ModifiedTime, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" 
                                           Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCloudService.Value.IsConnected}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <iconPacks:PackIconMaterial Kind="CloudOffOutline" Width="48" Height="48" 
                                            HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,10"/>
                <TextBlock Text="未連携です" FontSize="16" FontWeight="Bold" 
                           HorizontalAlignment="Center" Foreground="Gray"/>
                <TextBlock Text="「連携」タブからサインインしてください" Margin="0,5,0,0" 
                           HorizontalAlignment="Center" Foreground="Gray"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,10">
            <TextBlock x:Name="ProgressText" Text="処理中..." Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0" x:Name="ProgressBar" Height="20" Minimum="0" Maximum="100"/>
                <Button Grid.Column="1"
                        x:Name="CancelButton"
                        Margin="6,0,0,0"
                        Padding="8,0"
                        Height="20"
                        Content="中止"
                        Click="OnCancelClick"/>
            </Grid>
        </StackPanel>

        <Button Grid.Row="3"
                x:Name="UploadButton" 
                Height="35" 
                IsEnabled="False"
                Click="OnUploadClick">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="CloudUpload" Width="18" Height="18" Margin="0,0,8,0"/>
                <TextBlock Text="プロジェクトを保存" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>