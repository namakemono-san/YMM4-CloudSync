<UserControl x:Class="YMM4CloudSync.Core.Views.Tabs.ProjectTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:YMM4CloudSync.Core.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance vm:ProjectTabViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="プロジェクト一覧"
                       VerticalAlignment="Center"
                       FontWeight="Bold"/>

            <ComboBox Grid.Column="2"
                      Width="160"
                      Margin="0,0,8,0"
                      ItemsSource="{Binding Tool.CloudServices}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding Tool.SelectedCloudService.Value, Mode=TwoWay}"/>

            <Button Grid.Column="3"
                    Padding="5,2"
                    Command="{Binding RefreshCommand}"
                    ToolTip="更新">
                <iconPacks:PackIconMaterial Kind="Refresh" Width="12" Height="12"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListBox x:Name="CloudFilesList"
                     Margin="0,0,0,10"
                     MinHeight="100"
                     HorizontalContentAlignment="Stretch"
                     ItemsSource="{Binding Files}"
                     Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                <ListBox.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding OpenCommand}"
                                  CommandParameter="{Binding SelectedItem, ElementName=CloudFilesList}"/>
                </ListBox.InputBindings>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Padding="4" Margin="2,0" ToolTip="開く"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <iconPacks:PackIconMaterial Kind="FolderOpen" Width="14" Height="14"/>
                                </Button>
                                <Button Padding="4" Margin="2,0" ToolTip="ダウンロード"
                                        Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <iconPacks:PackIconMaterial Kind="Download" Width="14" Height="14"/>
                                </Button>
                                <Button Padding="4" Margin="2,0" ToolTip="削除"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14" Foreground="Red"/>
                                </Button>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding ModifiedTime, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}"
                                           Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <iconPacks:PackIconMaterial Kind="CloudOffOutline" Width="48" Height="48"
                                            HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,10"/>
                <TextBlock Text="未連携です" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="Gray"/>
                <TextBlock Text="「連携」タブからサインインしてください" Margin="0,5,0,0"
                           HorizontalAlignment="Center" Foreground="Gray"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,10"
                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ProgressText}" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0" Height="20" Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"/>
                <Button Grid.Column="1"
                        Margin="6,0,0,0"
                        Padding="8,0"
                        Height="20"
                        Content="中止"
                        Command="{Binding CancelCommand}"/>
            </Grid>
        </StackPanel>

        <Button Grid.Row="3"
                Height="35"
                Command="{Binding UploadCommand}"
                ToolTip="{Binding UploadBlockedReason}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="CloudUpload" Width="18" Height="18" Margin="0,0,8,0"/>
                <TextBlock Text="プロジェクトを保存" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Button Grid.Row="4"
                Height="30"
                Margin="0,6,0,0"
                Command="{Binding ExportCommand}"
                ToolTip="クラウドにアップロードせず、プロジェクトを .ymmx ファイルとして書き出します。">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="PackageVariantClosed" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="YMMX ファイルとして書き出し" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
