<UserControl x:Class="YMM4CloudSync.Core.Views.Tabs.AssetTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Plugin"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             xmlns:vm="clr-namespace:YMM4CloudSync.Core.ViewModels"
             xmlns:conv="clr-namespace:YMM4CloudSync.Core.Views.Converters"
             xmlns:models="clr-namespace:YMM4CloudSync.Core.Models"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:AssetTabViewModel}"
             AllowDrop="True"
             DragOver="OnAssetsDragOver"
             Drop="OnAssetsDrop">

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

            <ItemsPanelTemplate x:Key="VirtualizedStackPanelItemsPanelTemplate">
                <VirtualizingStackPanel IsItemsHost="True" Orientation="Vertical" Margin="3"/>
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="VirtualizedWrapPanelItemsPanelTemplate">
                <c:VirtualizingWrapPanel ItemWidth="{Binding Layout.ItemWidth}" ItemHeight="{Binding Layout.ItemHeight}" CacheRows="2" Margin="3"/>
            </ItemsPanelTemplate>

            <DataTemplate x:Key="ToolTipTemplate">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="{Binding Icon}" MaxWidth="128" MaxHeight="128" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="1" Text="{Binding DetailsTooltip}" TextWrapping="Wrap" MaxWidth="300"/>
                </Grid>
            </DataTemplate>

            <Style x:Key="TypeGlyphStyle" TargetType="Path">
                <Setter Property="Data" Value="{DynamicResource {x:Static icons:GeometryKeys.File}}"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Fill" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                <Setter Property="Visibility" Value="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Category}" Value="Folder">
                        <Setter Property="Data" Value="{DynamicResource {x:Static icons:GeometryKeys.Folder}}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Category}" Value="Video">
                        <Setter Property="Data" Value="{DynamicResource {x:Static icons:GeometryKeys.FileVideo}}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Category}" Value="Image">
                        <Setter Property="Data" Value="{DynamicResource {x:Static icons:GeometryKeys.FileImage}}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Category}" Value="Audio">
                        <Setter Property="Data" Value="{DynamicResource {x:Static icons:GeometryKeys.FileMusic}}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Category}" Value="Text">
                        <Setter Property="Data" Value="{DynamicResource {x:Static icons:GeometryKeys.FileDocument}}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StateGlyphStyle" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <DataTemplate x:Key="StateBadgeTemplate">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Path Data="{DynamicResource {x:Static icons:GeometryKeys.CloudOutline}}" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" Stretch="Uniform" Width="11" Height="11" Opacity="0.5">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource StateGlyphStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="NotDownloaded">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <Path Data="{DynamicResource {x:Static icons:GeometryKeys.CheckCircle}}" Fill="SeaGreen" Stretch="Uniform" Width="11" Height="11">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource StateGlyphStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Downloaded">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <Path Data="{DynamicResource {x:Static icons:GeometryKeys.Update}}" Fill="DarkOrange" Stretch="Uniform" Width="11" Height="11">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource StateGlyphStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Stale">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <Path Data="{DynamicResource {x:Static icons:GeometryKeys.AlertCircle}}" Fill="OrangeRed" Stretch="Uniform" Width="11" Height="11">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource StateGlyphStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <ProgressBar Width="34" Height="5" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource StateGlyphStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Downloading">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ListViewItemTemplate">
                <Grid Background="Transparent" ToolTipService.Placement="Right">
                    <Grid.ToolTip>
                        <ToolTip ContentTemplate="{StaticResource ToolTipTemplate}" Content="{Binding}"/>
                    </Grid.ToolTip>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,4,0" VerticalAlignment="Center"
                          Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox},Path=DataContext.Layout.IconSize, FallbackValue=16}"
                          Height="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox},Path=DataContext.Layout.IconSize, FallbackValue=16}">
                        <Image Source="{Binding Icon}" Stretch="Uniform"/>
                        <Path Style="{StaticResource TypeGlyphStyle}" Width="Auto" Height="Auto"/>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ContentPresenter Grid.Column="2" Margin="6,0,2,0" Content="{Binding}" ContentTemplate="{StaticResource StateBadgeTemplate}"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="IconsViewItemTemplate">
                <Grid Background="Transparent" ToolTipService.Placement="Right">
                    <Grid.ToolTip>
                        <ToolTip ContentTemplate="{StaticResource ToolTipTemplate}" Content="{Binding}"/>
                    </Grid.ToolTip>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox},Path=DataContext.Layout.IconSize, FallbackValue=32}"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Image Source="{Binding Icon}" Stretch="Uniform"/>
                        <Path Style="{StaticResource TypeGlyphStyle}" Width="Auto" Height="Auto"/>
                        <ContentPresenter Margin="0,1,1,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Content="{Binding}" ContentTemplate="{StaticResource StateBadgeTemplate}"/>
                    </Grid>
                    <Grid Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="2,0">
                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Grid>
            </DataTemplate>

            <ContextMenu x:Key="FileItemContextMenu">
                <MenuItem Header="タイムラインに追加"
                          Command="{Binding DataContext.AddToTimelineCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox}}"
                          CommandParameter="{Binding}"/>
                <Separator/>
                <MenuItem Header="ダウンロード" Icon="{DynamicResource {x:Static icons:IconKeys.CloudDownload}}"
                          Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox}}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="ダウンロードしてフォルダーを開く"
                          Command="{Binding DataContext.DownloadAndOpenFolderCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox}}"
                          CommandParameter="{Binding}"/>
                <MenuItem Header="ダウンロードを中止"
                          Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox}}"
                          CommandParameter="{Binding}"/>
                <Separator/>
                <MenuItem Header="削除" Icon="{DynamicResource {x:Static icons:IconKeys.Delete}}"
                          Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox}}"
                          CommandParameter="{Binding}"/>
            </ContextMenu>

            <ContextMenu x:Key="FolderItemContextMenu">
                <MenuItem Header="開く" Icon="{DynamicResource {x:Static icons:IconKeys.FolderOpen}}"
                          Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox}}"
                          CommandParameter="{Binding}"/>
                <Separator/>
                <MenuItem Header="削除" Icon="{DynamicResource {x:Static icons:IconKeys.Delete}}"
                          Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=ListBox}}"
                          CommandParameter="{Binding}"/>
            </ContextMenu>

            <ContextMenu x:Key="FileListBoxContextMenu">
                <MenuItem Header="並べ替え" Icon="{DynamicResource {x:Static icons:IconKeys.Sort}}">
                    <MenuItem Header="名前" IsCheckable="True" IsChecked="{Binding IsSortByName, Mode=OneWay}" Command="{Binding SwitchSortKeyCommand}" CommandParameter="Name"/>
                    <MenuItem Header="種類" IsCheckable="True" IsChecked="{Binding IsSortByType, Mode=OneWay}" Command="{Binding SwitchSortKeyCommand}" CommandParameter="Type"/>
                    <MenuItem Header="サイズ" IsCheckable="True" IsChecked="{Binding IsSortBySize, Mode=OneWay}" Command="{Binding SwitchSortKeyCommand}" CommandParameter="Size"/>
                    <MenuItem Header="更新日時" IsCheckable="True" IsChecked="{Binding IsSortByModifiedTime, Mode=OneWay}" Command="{Binding SwitchSortKeyCommand}" CommandParameter="ModifiedTime"/>
                    <Separator/>
                    <MenuItem Header="昇順" IsCheckable="True" IsChecked="{Binding IsSortAscending, Mode=OneWay}" Command="{Binding SwitchSortOrderCommand}" CommandParameter="Ascending" Icon="{DynamicResource {x:Static icons:IconKeys.SortAscending}}"/>
                    <MenuItem Header="降順" IsCheckable="True" IsChecked="{Binding SortDescending, Mode=OneWay}" Command="{Binding SwitchSortOrderCommand}" CommandParameter="Descending" Icon="{DynamicResource {x:Static icons:IconKeys.SortDescending}}"/>
                </MenuItem>
                <MenuItem Header="表示">
                    <MenuItem Header="一覧" IsCheckable="True" IsChecked="{Binding Layout.IsList, Mode=OneWay}" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Static models:AssetViewMode.List}"/>
                    <MenuItem Header="並べて表示" IsCheckable="True" IsChecked="{Binding Layout.IsWrapList, Mode=OneWay}" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Static models:AssetViewMode.WrapList}"/>
                    <MenuItem Header="大きいアイコン" IsCheckable="True" IsChecked="{Binding Layout.IsTiles, Mode=OneWay}" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Static models:AssetViewMode.Tiles}"/>
                </MenuItem>
                <MenuItem Header="表示を大きくする" Command="{Binding IncreaseLayoutSizeCommand}" Icon="{DynamicResource {x:Static icons:IconKeys.MagnifyPlus}}"/>
                <MenuItem Header="表示を小さくする" Command="{Binding DecreaseLayoutSizeCommand}" Icon="{DynamicResource {x:Static icons:IconKeys.MagnifyMinus}}"/>
                <Separator/>
                <MenuItem Header="新しいフォルダー" Command="{Binding BeginCreateFolderCommand}" Icon="{DynamicResource {x:Static icons:IconKeys.FolderPlus}}"/>
                <MenuItem Header="アップロード" Command="{Binding UploadCommand}" Icon="{DynamicResource {x:Static icons:IconKeys.CloudUpload}}"/>
                <Separator/>
                <MenuItem Header="更新" Command="{Binding RefreshCommand}" Icon="{DynamicResource {x:Static icons:IconKeys.Refresh}}"/>
            </ContextMenu>

            <Style x:Key="FileListBoxStyle" TargetType="ListBox">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Layout.Mode}" Value="List">
                        <Setter Property="ItemsPanel" Value="{StaticResource VirtualizedStackPanelItemsPanelTemplate}"/>
                        <Setter Property="ItemTemplate" Value="{StaticResource ListViewItemTemplate}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Layout.Mode}" Value="WrapList">
                        <Setter Property="ItemsPanel" Value="{StaticResource VirtualizedWrapPanelItemsPanelTemplate}"/>
                        <Setter Property="ItemTemplate" Value="{StaticResource ListViewItemTemplate}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Layout.Mode}" Value="Tiles">
                        <Setter Property="ItemsPanel" Value="{StaticResource VirtualizedWrapPanelItemsPanelTemplate}"/>
                        <Setter Property="ItemTemplate" Value="{StaticResource IconsViewItemTemplate}"/>
                    </DataTrigger>
                </Style.Triggers>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="ContextMenu" Value="{StaticResource FileListBoxContextMenu}"/>
            </Style>

            <Style x:Key="FileListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                        <Setter Property="ContextMenu" Value="{StaticResource FolderItemContextMenu}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFolder}" Value="False">
                        <Setter Property="ContextMenu" Value="{StaticResource FileItemContextMenu}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.Resources>
                <Style x:Key="ToolBarButtonStyle" TargetType="Button">
                    <Setter Property="Padding" Value="3"/>
                    <Setter Property="Width" Value="26"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition MaxWidth="125"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{DynamicResource {x:Static icons:IconKeys.ArrowLeft}}" Command="{Binding BackCommand}" ToolTip="戻る" Style="{StaticResource ToolBarButtonStyle}"/>
            <Button Grid.Column="1" Content="{DynamicResource {x:Static icons:IconKeys.ArrowRight}}" Command="{Binding ForwardCommand}" ToolTip="進む" Style="{StaticResource ToolBarButtonStyle}"/>
            <Button Grid.Column="2" Content="{DynamicResource {x:Static icons:IconKeys.ArrowUp}}" Command="{Binding GoUpCommand}" ToolTip="上のフォルダーへ" Style="{StaticResource ToolBarButtonStyle}"/>

            <ComboBox Grid.Column="3" Width="110" Height="26" Margin="0,0,0,0" VerticalContentAlignment="Center"
                      ItemsSource="{Binding Tool.CloudServices}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding Tool.SelectedCloudService.Value, Mode=TwoWay}"/>

            <Border Grid.Column="4" Margin="0,0,0,0" Height="26" Padding="2,0"
                    BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="›" Margin="2,0" VerticalAlignment="Center" Opacity="0.5"/>
                                    <Button Content="{Binding Name}" Padding="4,1" MinWidth="0"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Button Grid.Column="5" Margin="0,0,0,0" Content="{DynamicResource {x:Static icons:IconKeys.FolderPlus}}" Command="{Binding BeginCreateFolderCommand}" ToolTip="新しいフォルダー" Style="{StaticResource ToolBarButtonStyle}"/>
            <Button Grid.Column="6" Content="{DynamicResource {x:Static icons:IconKeys.CloudUpload}}" Command="{Binding UploadCommand}" ToolTip="このフォルダーに素材をアップロードします。エクスプローラーからのドロップでも追加できます。" Style="{StaticResource ToolBarButtonStyle}"/>

            <c:PopupButton Grid.Column="8" PopupWidth="300" PopupHeight="130" ResizeMode="None" Padding="3" Height="26" Margin="0,0,0,0" ToolTip="絞り込み">
                <c:PopupButton.Style>
                    <Style TargetType="{x:Type c:PopupButton}">
                        <Setter Property="Content" Value="{DynamicResource {x:Static icons:IconKeys.FilterOff}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilteredByType}" Value="True">
                                <Setter Property="Content" Value="{DynamicResource {x:Static icons:IconKeys.Filter}}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </c:PopupButton.Style>
                <c:PopupButton.PopupContent>
                    <Grid>
                        <Grid.Resources>
                            <ResourceDictionary>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Height" Value="26"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                </Style>
                            </ResourceDictionary>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" Content="動画" IsChecked="{Binding ShowVideo,Mode=TwoWay}"/>
                        <CheckBox Grid.Row="1" Grid.Column="0" Content="音声" IsChecked="{Binding ShowAudio,Mode=TwoWay}"/>
                        <CheckBox Grid.Row="2" Grid.Column="0" Content="画像" IsChecked="{Binding ShowImage,Mode=TwoWay}"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" Content="テキスト" IsChecked="{Binding ShowText,Mode=TwoWay}"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="フォルダー" IsChecked="{Binding ShowFolder,Mode=TwoWay}"/>
                        <CheckBox Grid.Row="2" Grid.Column="1" Content="その他" IsChecked="{Binding ShowOther,Mode=TwoWay}"/>
                        <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="取得済みのみ" IsChecked="{Binding DownloadedOnly,Mode=TwoWay}"/>
                    </Grid>
                </c:PopupButton.PopupContent>
            </c:PopupButton>

            <TextBox x:Name="searchTextBox" Grid.Column="9" Height="26" Margin="0,0,0,0" Padding="3,0,3,0" VerticalContentAlignment="Center"
                     Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}"/>
            <TextBlock Grid.Column="9" Text="検索" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" VerticalAlignment="Center" Margin="10,0,3,0" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=searchTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, ElementName=searchTextBox}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <c:DropDownButton Grid.Column="10" Margin="0,0,0,0" Padding="3" Width="26" Height="26"
                              Content="{DynamicResource {x:Static icons:IconKeys.Menu}}" ToolTip="表示と並べ替え">
                <c:DropDownButton.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="並べ替え" Icon="{DynamicResource {x:Static icons:IconKeys.Sort}}">
                            <MenuItem Header="名前" IsCheckable="True" IsChecked="{Binding IsSortByName, Mode=OneWay}" Command="{Binding SwitchSortKeyCommand}" CommandParameter="Name"/>
                            <MenuItem Header="種類" IsCheckable="True" IsChecked="{Binding IsSortByType, Mode=OneWay}" Command="{Binding SwitchSortKeyCommand}" CommandParameter="Type"/>
                            <MenuItem Header="サイズ" IsCheckable="True" IsChecked="{Binding IsSortBySize, Mode=OneWay}" Command="{Binding SwitchSortKeyCommand}" CommandParameter="Size"/>
                            <MenuItem Header="更新日時" IsCheckable="True" IsChecked="{Binding IsSortByModifiedTime, Mode=OneWay}" Command="{Binding SwitchSortKeyCommand}" CommandParameter="ModifiedTime"/>
                            <Separator/>
                            <MenuItem Header="昇順" IsCheckable="True" IsChecked="{Binding IsSortAscending, Mode=OneWay}" Command="{Binding SwitchSortOrderCommand}" CommandParameter="Ascending" Icon="{DynamicResource {x:Static icons:IconKeys.SortAscending}}"/>
                            <MenuItem Header="降順" IsCheckable="True" IsChecked="{Binding SortDescending, Mode=OneWay}" Command="{Binding SwitchSortOrderCommand}" CommandParameter="Descending" Icon="{DynamicResource {x:Static icons:IconKeys.SortDescending}}"/>
                        </MenuItem>
                        <MenuItem Header="表示">
                            <MenuItem Header="一覧" IsCheckable="True" IsChecked="{Binding Layout.IsList, Mode=OneWay}" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Static models:AssetViewMode.List}"/>
                            <MenuItem Header="並べて表示" IsCheckable="True" IsChecked="{Binding Layout.IsWrapList, Mode=OneWay}" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Static models:AssetViewMode.WrapList}"/>
                            <MenuItem Header="大きいアイコン" IsCheckable="True" IsChecked="{Binding Layout.IsTiles, Mode=OneWay}" Command="{Binding SwitchViewCommand}" CommandParameter="{x:Static models:AssetViewMode.Tiles}"/>
                        </MenuItem>
                        <MenuItem Header="表示を大きくする" Command="{Binding IncreaseLayoutSizeCommand}" Icon="{DynamicResource {x:Static icons:IconKeys.MagnifyPlus}}"/>
                        <MenuItem Header="表示を小さくする" Command="{Binding DecreaseLayoutSizeCommand}" Icon="{DynamicResource {x:Static icons:IconKeys.MagnifyMinus}}"/>
                        <Separator/>
                        <MenuItem Header="更新" Command="{Binding RefreshCommand}" Icon="{DynamicResource {x:Static icons:IconKeys.Refresh}}"/>
                    </ContextMenu>
                </c:DropDownButton.ContextMenu>
            </c:DropDownButton>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox x:Name="AssetList" Grid.Row="0"
                     ItemsSource="{Binding AssetsView}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLength="5"
                     ScrollViewer.CanContentScroll="True"
                     Style="{StaticResource FileListBoxStyle}"
                     ItemContainerStyle="{StaticResource FileListBoxItemStyle}"
                     SelectionMode="Extended"
                     PreviewMouseWheel="OnListPreviewMouseWheel"
                     MouseDoubleClick="OnListMouseDoubleClick"
                     PreviewMouseLeftButtonDown="OnListPreviewMouseLeftButtonDown"
                     PreviewMouseLeftButtonUp="OnListPreviewMouseLeftButtonUp"
                     PreviewMouseMove="OnListPreviewMouseMove"
                     Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.CloudOffOutline}}" Fill="Gray" Stretch="Uniform" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="未連携です" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="Gray"/>
                <TextBlock Text="「連携」タブからサインインしてください" Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="Gray"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="4" Visibility="{Binding IsCreatingFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0" Content="{DynamicResource {x:Static icons:IconKeys.FolderPlus}}" Width="14" Height="14" VerticalAlignment="Center" Margin="2,0,8,0"/>
                <TextBox x:Name="NewFolderNameBox" Grid.Column="1" VerticalContentAlignment="Center"
                         Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ConfirmCreateFolderCommand}"/>
                        <KeyBinding Key="Escape" Command="{Binding CancelCreateFolderCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="2" Content="作成" Padding="8,2" Margin="6,0,0,0" Command="{Binding ConfirmCreateFolderCommand}"/>
                <Button Grid.Column="3" Content="中止" Padding="8,2" Margin="4,0,0,0" Command="{Binding CancelCreateFolderCommand}"/>
            </Grid>

            <StackPanel Grid.Row="3" Margin="4" Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ProgressText}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Height="18" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"/>
                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,0" Height="18" Content="中止" Command="{Binding CancelCommand}"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
