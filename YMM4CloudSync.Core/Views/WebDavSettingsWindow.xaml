<Window x:Class="YMM4CloudSync.Core.Views.WebDavSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="WebDAV 接続設定"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="表示名" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="DisplayNameBox"
                 VerticalContentAlignment="Center" Height="26" Margin="0,4"/>

        <Label Grid.Row="1" Grid.Column="0" Content="サーバー URL" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ServerUrlBox"
                 VerticalContentAlignment="Center" Height="26" Margin="0,4"/>

        <TextBlock Grid.Row="2" Grid.Column="1" Margin="2,0,0,8"
                   FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                   Text="例: https://example.com/remote.php/dav/files/username/"/>

        <Label Grid.Row="3" Grid.Column="0" Content="ユーザー名" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="UserNameBox"
                 VerticalContentAlignment="Center" Height="26" Margin="0,4"/>

        <Label Grid.Row="4" Grid.Column="0" Content="パスワード" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="PasswordBox"
                     VerticalContentAlignment="Center" Height="26" Margin="0,4"/>

        <TextBlock Grid.Row="5" Grid.Column="1" Margin="2,0,0,8"
                   FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                   Text="Nextcloud / ownCloud で2要素認証を有効にしている場合は、通常のパスワードではなくアプリパスワードを入力してください。"/>

        <Label Grid.Row="6" Grid.Column="0" Content="保存先フォルダ" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="BasePathBox"
                 VerticalContentAlignment="Center" Height="26" Margin="0,4"/>

        <Label Grid.Row="7" Grid.Column="0" Content="認証方式" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="7" Grid.Column="1" x:Name="AuthModeBox"
                  Height="26" Margin="0,4" VerticalContentAlignment="Center">
            <ComboBoxItem Content="Basic (既定)"/>
            <ComboBoxItem Content="Digest"/>
            <ComboBoxItem Content="自動 (サーバーの要求に従う)"/>
        </ComboBox>

        <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,10,0,0">
            <CheckBox x:Name="ChunkedUploadCheckBox"
                      Content="大きいファイルを分割してアップロードする (Nextcloud / ownCloud)"/>
            <TextBlock Margin="20,2,0,8" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                       Text="16MB 以上のファイルを 10MB ずつ送信し、中断しても続きから再開できます。対応していないサーバーでは自動的に通常の送信に切り替わります。"/>

            <CheckBox x:Name="AllowInsecureCheckBox"
                      Content="安全でない接続 (http://) を許可する"
                      Checked="OnRiskyOptionChanged" Unchecked="OnRiskyOptionChanged"/>

            <CheckBox x:Name="AllowUntrustedCertificateCheckBox" Margin="0,6,0,0"
                      Content="証明書の検証を無効にする"
                      Checked="OnRiskyOptionChanged" Unchecked="OnRiskyOptionChanged"/>

            <TextBlock x:Name="RiskWarningText"
                       Margin="20,6,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="#C0392B" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Margin="0,0,12,0" FontSize="11" Opacity="0.8"/>
            <Button x:Name="ConnectButton" Content="接続" Width="90" Height="28"
                    Margin="0,0,8,0" IsDefault="True" Click="OnConnectClick"/>
            <Button Content="キャンセル" Width="90" Height="28"
                    IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
