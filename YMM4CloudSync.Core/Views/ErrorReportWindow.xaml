<Window x:Class="YMM4CloudSync.Core.Views.ErrorReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="エラー報告 - YMM4 Cloud Sync" Width="500" Height="270"
        MinHeight="270" MaxHeight="400"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,10,10,0">
                <TextBlock Text="予期せぬエラーが発生しました" Margin="0,0,0,2"/>

                <TextBox x:Name="ErrorMessageBox" IsReadOnly="True" 
                         Background="Transparent" BorderThickness="0"
                         TextWrapping="Wrap" Margin="0,0,0,4"/>

                <Grid Height="100" Margin="0,0,0,10">
                    <TextBox Name="CommentTextBox" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Padding="4"/>
                    
                    <TextBlock Text="ここに再現手順や直前の操作を入力してください..." 
                               IsHitTestVisible="False" Foreground="Gray" Margin="8,6,0,0" VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=CommentTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFocused, ElementName=CommentTextBox}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Expander Header="詳細情報" Margin="0,0,0,10">
                    <StackPanel Margin="0,5,0,0">
                        <Button Content="エラー内容をコピー" HorizontalAlignment="Right" 
                                Click="CopyError_Click" Margin="0,0,0,5" Padding="10,2"/>

                        <TextBox x:Name="StackTraceBox" IsReadOnly="True" Height="150"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Padding="4" FontFamily="Consolas, Courier New" FontSize="11"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" 
                    Margin="10,5,10,10">
            <Button Content="閉じる" Width="100" Height="26" Margin="0,0,10,0" Click="CloseButton_Click"/>
            <Button Content="レポートを送信" Width="120" Height="26" Click="SendButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>