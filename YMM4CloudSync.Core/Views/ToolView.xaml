<UserControl x:Class="YMM4CloudSync.Core.Views.ToolView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:YMM4CloudSync.Core.Views"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="Cloud Sync" 
                       FontSize="16" 
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Border Grid.Row="1" 
                    BorderBrush="Gray" 
                    BorderThickness="1"
                    Margin="0,0,0,10">
                <TextBlock Text="プロジェクト一覧（未実装）" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           Foreground="Gray"/>
            </Border>

            <Button Grid.Row="2" 
                    x:Name="ExportButton"
                    Content="現在のプロジェクトを ymmx にエクスポート"
                    Height="30"
                    Click="OnExportClick"/>
        </Grid>
    </StackPanel>
</UserControl>
