<Window x:Class="YMM4CloudSync.Core.Views.UpdateNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="YMM4 Cloud Sync - 更新" 
        Height="350" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <iconPacks:PackIconMaterial Kind="CloudDownload" Width="32" Height="32" Foreground="#0078D7" VerticalAlignment="Center"/>
            <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="新しいバージョンがあります" FontSize="16" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="現在のバージョン: " Foreground="Gray"/>
                    <TextBlock x:Name="CurrentVersionText" Text="1.0.0" Foreground="Gray" Margin="0,0,15,0"/>
                    <TextBlock Text="最新バージョン: " FontWeight="Bold"/>
                    <TextBlock x:Name="LatestVersionText" Text="1.1.0" Foreground="#0078D7" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="リリースノート" Margin="0,0,0,15">
            <TextBox x:Name="ReleaseNotesText"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Padding="5"/>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="ブラウザでダウンロード" 
                    Padding="15,5" 
                    Margin="0,0,10,0" 
                    Click="OnDownloadClick"
                    Background="#0078D7" 
                    Foreground="White"/>
            <Button Content="閉じる" 
                    Padding="15,5" 
                    Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
